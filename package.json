{
  "name": "tomorrowedge",
  "version": "1.0.0",
  "description": "A TUI cockpit for multi-model coding agents.",
  "type": "module",
  "bin": {
    "tedge": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node scripts/tsx-dev.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm test && npm run build && npm run secrets:scan && npm run audit:check && npm run pack:dry",
    "site:serve": "node scripts/serve-site.mjs",
    "smoke:cli": "tsx src/cli/index.ts --help && tsx src/cli/index.ts doctor --json",
    "audit:check": "tsx scripts/audit-check.ts",
    "secrets:scan": "tsx scripts/secret-scan.ts",
    "prepack": "npm test && npm run build",
    "pack:dry": "tsx scripts/pack-dry.ts",
    "doctor": "node scripts/tsx-dev.mjs doctor",
    "tui": "node scripts/tsx-dev.mjs tui",
    "smoke:real": "node scripts/tsx-dev.mjs models --real-smoke",
    "screenshots:tui": "node scripts/capture-tui-screenshots.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "README.product.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/*.md",
    "scripts/audit-check.ts",
    "scripts/pack-dry.ts",
    "scripts/secret-scan.ts",
    "examples/tiny-local-lm/ARCHITECTURE.md",
    "examples/tiny-local-lm/README.md",
    "examples/tiny-local-lm/package.json",
    "examples/tiny-local-lm/server.js",
    "examples/tiny-local-lm/public",
    "examples/tiny-local-lm/scripts",
    "examples/tiny-local-lm/src",
    "examples/tiny-local-lm/tests"
  ],
  "keywords": [
    "tui",
    "coding-agent",
    "multi-model",
    "agent-orchestration"
  ],
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axobase001/tomorrowedge.git"
  },
  "bugs": {
    "url": "https://github.com/axobase001/tomorrowedge/issues"
  },
  "homepage": "https://github.com/axobase001/tomorrowedge#readme",
  "packageManager": "npm@11.8.0",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "diff": "^8.0.4",
    "execa": "^9.5.2",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.3",
    "ink": "^5.1.0",
    "react": "^18.3.1",
    "simple-git": "^3.27.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "playwright": "^1.60.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  }
}
