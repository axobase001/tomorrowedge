{
  "name": "@axobase001/tomorrowedge",
  "version": "1.6.1",
  "description": "Local orchestration, governance, and strategy-evolution runtime for heterogeneous Coding Agents.",
  "type": "module",
  "bin": {
    "tedge": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "web:dev": "vite --config src/cockpit-web/vite.config.ts",
    "web:build": "vite build --config src/cockpit-web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node scripts/tsx-dev.mjs",
    "test": "vitest run --fileParallelism=false",
    "test:core": "vitest run tests/unit/taskMemory.test.ts tests/unit/benchmark.test.ts tests/unit/cockpitViewModel.test.ts tests/unit/preferences.test.ts --fileParallelism=false",
    "test:adaptive": "vitest run tests/unit/objectiveContract.test.ts tests/unit/objectiveTracePolicy.test.ts tests/unit/agentGraph.test.ts tests/unit/roleGraph.test.ts tests/unit/roleGraphScheduler.test.ts tests/unit/taskGraph.test.ts tests/unit/taskGraphScheduler.test.ts tests/unit/adaptiveRuntime.test.ts tests/unit/budgetGate.test.ts --fileParallelism=false",
    "test:council": "vitest run tests/unit/agentCouncilRuntime.test.ts --fileParallelism=false",
    "test:evolution": "vitest run tests/unit/objectiveTracePolicy.test.ts tests/unit/agentCouncilRuntime.test.ts --fileParallelism=false",
    "test:integration": "vitest run tests/integration --fileParallelism=false",
    "test:ui": "vitest run tests/unit/cockpitViewModel.test.ts tests/unit/localCockpit.test.ts tests/unit/cockpitWeb.test.ts --fileParallelism=false",
    "test:memory": "vitest run tests/unit/taskMemory.test.ts tests/unit/failureMemoryInfluence.test.ts tests/unit/errorLoopExperiment.test.ts --fileParallelism=false",
    "test:control": "vitest run tests/unit/controlPlane.test.ts tests/unit/canopusCli.test.ts --fileParallelism=false",
    "test:watch": "vitest",
    "e2e:cockpit": "npm run build && npm run web:build && tsx scripts/cockpit-e2e-smoke.ts",
    "verify:fast": "npm run build && npm run web:build && npm run docs:status && npm run secrets:scan && npm run audit:check && npm run test:core && npm run test:council",
    "verify:release-gates": "npm run build && npm run web:build && npm run docs:status && npm run secrets:scan && npm run audit:check && npm run package:smoke && npm run pack:dry:strict",
    "verify": "npm test && npm run build && npm run web:build && npm run docs:status && npm run secrets:scan && npm run audit:check && npm run pack:dry",
    "release:verify": "npm run verify && npm run package:smoke && npm run pack:dry:strict",
    "site:serve": "node scripts/serve-site.mjs",
    "smoke:cli": "tsx src/cli/index.ts --help && tsx src/cli/index.ts doctor --json",
    "audit:check": "tsx scripts/audit-check.ts",
    "docs:status": "tsx scripts/docs-status-check.ts",
    "secrets:scan": "tsx scripts/secret-scan.ts",
    "prepack": "npm test && npm run build && npm run web:build",
    "pack:dry": "tsx scripts/pack-dry.ts",
    "pack:dry:strict": "tsx scripts/pack-dry.ts --strict",
    "package:smoke": "npm run build && npm run web:build && tsx scripts/package-smoke.ts",
    "package:zip": "tsx scripts/package-zip.ts",
    "doctor": "node scripts/tsx-dev.mjs doctor",
    "client": "node scripts/tsx-dev.mjs client",
    "desktop": "node scripts/tsx-dev.mjs desktop",
    "tui": "node scripts/tsx-dev.mjs tui",
    "smoke:real": "node scripts/tsx-dev.mjs models --real-smoke",
    "screenshots:tui": "node scripts/capture-tui-screenshots.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "README.product.md",
    "CHANGELOG.md",
    "LICENSE",
    "desktop/*.cjs",
    "docs/*.md",
    "docs/adr/*.md",
    "docs/ui/screenshots/gui-v1.5/*.png",
    "scripts/audit-check.ts",
    "scripts/cockpit-e2e-smoke.ts",
    "scripts/docs-status-check.ts",
    "scripts/pack-dry.ts",
    "scripts/package-smoke.ts",
    "scripts/package-zip.ts",
    "docs/AGENT_COUNCIL_GOVERNANCE.md",
    "docs/AGENT_CAPABILITY_PROFILES.md",
    "docs/CHIEF_AGENT_RUNTIME.md",
    "docs/DELEGATED_EXECUTION_RUNTIME.md",
    "docs/POLICY_EVOLUTION_RUNTIME.md",
    "scripts/secret-scan.ts",
    "examples/tiny-local-lm/ARCHITECTURE.md",
    "examples/tiny-local-lm/README.md",
    "examples/tiny-local-lm/package.json",
    "examples/tiny-local-lm/server.js",
    "examples/tiny-local-lm/public",
    "examples/tiny-local-lm/scripts",
    "examples/tiny-local-lm/src",
    "examples/tiny-local-lm/tests",
    "examples/configs",
    "examples/agent-council-rust-rewrite/README.md",
    "examples/agent-council-rust-rewrite/mock-command-agent.mjs",
    "examples/control_plane/*/README.md",
    "examples/control_plane/*/goal.yaml",
    "examples/control_plane/simple_bugfix_runtime/fix-bug.mjs",
    "examples/control_plane/simple_bugfix_runtime/index.js",
    "examples/control_plane/simple_bugfix_runtime/package.json",
    "examples/control_plane/simple_bugfix_runtime/test.js",
    "examples/canopus/simple_bugfix_runtime/README.md",
    "examples/canopus/simple_bugfix_runtime/objective.yaml",
    "examples/canopus/simple_bugfix_runtime/fix-bug.mjs",
    "examples/canopus/simple_bugfix_runtime/index.js",
    "examples/canopus/simple_bugfix_runtime/package.json",
    "examples/canopus/simple_bugfix_runtime/test.js",
    "src/core/controlPlane/templates"
  ],
  "keywords": [
    "gui-client",
    "coding-agent",
    "multi-model",
    "agent-orchestration",
    "agent-governance",
    "policy-evolution"
  ],
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axobase001/tomorrowedge.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/axobase001/tomorrowedge/issues"
  },
  "homepage": "https://github.com/axobase001/tomorrowedge#readme",
  "packageManager": "npm@11.8.0",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "diff": "^8.0.4",
    "execa": "^9.5.2",
    "fast-glob": "^3.3.3",
    "iconv-lite": "^0.6.3",
    "ignore": "^7.0.3",
    "ink": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-git": "^3.27.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.7",
    "playwright": "^1.60.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
